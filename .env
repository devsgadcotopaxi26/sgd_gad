# ============================================================
# SGD - GAD Provincia de Cotopaxi
# Variables de entorno — NO subir al repositorio git
# ============================================================

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion-usar-django-secret-key-gen
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,172.17.255.247

# Base de datos principal SGD (contenedor dentro del stack Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sgd_gad_cotopaxi
DB_USER=postgres
DB_PASSWORD=sgd2026
DB_HOST=postgres
DB_PORT=5432

# quipux_transaccional → en sgd_postgres (junto con sgd_gad_cotopaxi)
QUIPUX_DB_HOST=postgres
QUIPUX_DB_PORT=5432
QUIPUX_DB_USER=postgres
QUIPUX_DB_PASSWORD=sgd2026

# quipux_documental → contenedor propio con 122 GB de PDFs históricos
QUIPUX_DOC_DB_HOST=sgd_quipux_doc
QUIPUX_DOC_DB_PORT=5432
QUIPUX_DOC_DB_USER=postgres
QUIPUX_DOC_DB_PASSWORD=sgd2026

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email SMTP institucional
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.cotopaxi.gob.ec
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sgd@cotopaxi.gob.ec
EMAIL_HOST_PASSWORD=clave-email-institucional
DEFAULT_FROM_EMAIL=SGD GAD Cotopaxi <sgd@cotopaxi.gob.ec>

# FirmaEC - integración vía FirmaDigital service stack
FIRMAEC_SISTEMA=sgd-gad
FIRMAEC_API_KEY=sgd-gad-firma2026
FIRMAEC_CALLBACK_KEY=sgd-gad-callback-2026
# URL interna del FirmaDigital servicio (dentro de red Docker)
FIRMAEC_SERVICIO_URL=http://firmadigital_servicio:8080/servicio
# URL pública del FirmaDigital API proxy - accesible desde la PC del firmante
FIRMAEC_API_URL=http://172.17.255.247:8089/api

# Frontend
VITE_API_URL=http://172.17.255.247/api/v1
VITE_APP_NAME=SGD - GAD Cotopaxi
